VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_SITE_URL=https://webportfoliozumo.vercel.app

# Server-only variables for the Vercel contact API. Never prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CONTACT_RATE_LIMIT_SECRET=generate-a-long-random-secret

# Used only by `npm run db:setup`; never exposed to the browser.
POSTGRES_URL=postgresql://postgres.project-ref:password@pooler-host:5432/postgres?sslmode=require
